[Unit]
Description=Digital Signage kiosk mode controller
After=lightdm.service
Wants=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/signage-mode kiosk
ExecStop=/usr/local/sbin/signage-mode admin
TimeoutStartSec=15
TimeoutStopSec=15

[Install]
WantedBy=graphical.target
