[Unit]
Description=Digital Signage kiosk mode controller
After=lightdm.service
Wants=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/signage-kiosk-mode
ExecStop=/usr/local/sbin/signage-admin-mode
TimeoutStartSec=60
TimeoutStopSec=60

[Install]
WantedBy=graphical.target
