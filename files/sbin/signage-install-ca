#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage: signage-install-ca <url> <destination> <timeout-seconds>

Downloads a PEM-encoded CA certificate, installs it at <destination>, and runs
update-ca-certificates.
USAGE
}

log() { printf '[signage-install-ca] %s\n' "$*"; }
die() { printf '[signage-install-ca] ERROR: %s\n' "$*" >&2; exit 1; }

if [[ $# -ne 3 ]]; then
  usage >&2
  exit 2
fi

url="$1"
dest="$2"
timeout="$3"

[[ -n "${url}" ]] || die "URL must not be empty"
[[ -n "${dest}" ]] || die "Destination must not be empty"
[[ "${timeout}" =~ ^[0-9]+$ ]] || die "Timeout must be a non-negative integer"

install -d -m 0755 "$(dirname "${dest}")"

tmp="$(mktemp)"
cleanup() { rm -f "${tmp}"; }
trap cleanup EXIT

python3 - "${url}" "${tmp}" "${timeout}" <<'PY'
import sys
import urllib.request
import urllib.error

url, dest, timeout = sys.argv[1], sys.argv[2], int(sys.argv[3])
req = urllib.request.Request(url, headers={"User-Agent": "digital-signage-ca-installer/0.1"})
try:
    with urllib.request.urlopen(req, timeout=timeout) as response:
        data = response.read()
except urllib.error.HTTPError as exc:
    print(f"HTTP error {exc.code} {exc.reason} while downloading CA certificate {url}", file=sys.stderr)
    raise SystemExit(1)
except urllib.error.URLError as exc:
    print(f"URL error while downloading CA certificate {url}: {exc.reason}", file=sys.stderr)
    raise SystemExit(1)

if not data:
    print(f"CA certificate download was empty: {url}", file=sys.stderr)
    raise SystemExit(1)

with open(dest, "wb") as fh:
    fh.write(data)
PY

if ! grep -q 'BEGIN CERTIFICATE' "${tmp}"; then
  die "Downloaded CA certificate must be PEM format and contain BEGIN CERTIFICATE"
fi

install -m 0644 "${tmp}" "${dest}"
update-ca-certificates
log "Installed CA certificate at ${dest}"
