#!/usr/bin/env bash
set -Eeuo pipefail

LIGHTDM_CONF="/etc/lightdm/lightdm.conf"
RESTART_LIGHTDM="1"

log() { printf '[signage-admin-mode] %s\n' "$*"; }
die() { printf '[signage-admin-mode] ERROR: %s\n' "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-restart) RESTART_LIGHTDM="0" ;;
    --restart) RESTART_LIGHTDM="1" ;;
    *) die "Unknown argument: $1" ;;
  esac
  shift
done

if [[ "${EUID}" -ne 0 ]]; then
  die "Run as root, for example: sudo signage-admin-mode"
fi

log "Disabling LightDM signage autologin"

python3 - <<'PY'
from pathlib import Path

path = Path('/etc/lightdm/lightdm.conf')
text = path.read_text() if path.exists() else ''
remove_keys = {
    'autologin-user',
    'autologin-user-timeout',
    'autologin-session',
    'user-session',
}

lines = text.splitlines()
out = []
in_seat = False

for line in lines:
    stripped = line.strip()

    if stripped == '[Seat:*]':
        in_seat = True
        out.append(line)
        continue

    if in_seat and stripped.startswith('[') and stripped.endswith(']'):
        in_seat = False
        out.append(line)
        continue

    if in_seat and '=' in stripped:
        key = stripped.split('=', 1)[0].strip()
        if key in remove_keys:
            continue

    out.append(line)

path.write_text('\n'.join(out) + '\n')
PY

chmod 0644 "${LIGHTDM_CONF}"

shutdown_in_progress() {
  systemctl list-jobs --no-legend 2>/dev/null | grep -Eq '(reboot|poweroff|halt|shutdown)\.target'
}

if [[ "${RESTART_LIGHTDM}" == "1" ]]; then
  if shutdown_in_progress; then
    log "Shutdown/reboot appears to be in progress; skipping LightDM restart"
  else
    log "Restarting LightDM to show the graphical login screen"
    systemctl restart lightdm
  fi
else
  log "LightDM restart suppressed by --no-restart"
fi
