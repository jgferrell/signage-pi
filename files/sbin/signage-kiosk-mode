#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE="/etc/signage/signage.conf"
LIGHTDM_CONF="/etc/lightdm/lightdm.conf"
SIGNAGE_USER="signage-user"
SIGNAGE_SESSION="signage-session"
RESTART_LIGHTDM="1"

log() { printf '[signage-kiosk-mode] %s\n' "$*"; }
die() { printf '[signage-kiosk-mode] ERROR: %s\n' "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-restart) RESTART_LIGHTDM="0" ;;
    --restart) RESTART_LIGHTDM="1" ;;
    *) die "Unknown argument: $1" ;;
  esac
  shift
done

if [[ "${EUID}" -ne 0 ]]; then
  die "Run as root, for example: sudo signage-kiosk-mode"
fi

if [[ -f "${CONFIG_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${CONFIG_FILE}" || true
  SIGNAGE_USER="${SIGNAGE_USER:-signage-user}"
  SIGNAGE_SESSION="${SIGNAGE_SESSION:-signage-session}"
fi

if [[ "${SIGNAGE_USER}" != "signage-user" ]]; then
  die "This installer currently requires SIGNAGE_USER=\"signage-user\"."
fi
if [[ "${SIGNAGE_SESSION}" != "signage-session" ]]; then
  die "This installer currently requires SIGNAGE_SESSION=\"signage-session\"."
fi

log "Enabling LightDM autologin for ${SIGNAGE_USER}/${SIGNAGE_SESSION}"

python3 - <<'PY'
from pathlib import Path

path = Path('/etc/lightdm/lightdm.conf')
text = path.read_text() if path.exists() else ''
settings = {
    'autologin-user': 'signage-user',
    'autologin-user-timeout': '0',
    'user-session': 'signage-session',
    'autologin-session': 'signage-session',
}

lines = text.splitlines()
out = []
in_seat = False
seen_seat = False
written = set()

for line in lines:
    stripped = line.strip()

    if stripped == '[Seat:*]':
        in_seat = True
        seen_seat = True
        out.append(line)
        continue

    if in_seat and stripped.startswith('[') and stripped.endswith(']'):
        for key, value in settings.items():
            if key not in written:
                out.append(f'{key}={value}')
                written.add(key)
        in_seat = False

    if in_seat and '=' in stripped:
        key = stripped.split('=', 1)[0].strip()
        if key in settings:
            out.append(f'{key}={settings[key]}')
            written.add(key)
            continue

    out.append(line)

if seen_seat:
    if in_seat:
        for key, value in settings.items():
            if key not in written:
                out.append(f'{key}={value}')
                written.add(key)
else:
    if out and out[-1].strip():
        out.append('')
    out.append('[Seat:*]')
    for key, value in settings.items():
        out.append(f'{key}={value}')

path.write_text('\n'.join(out) + '\n')
PY

chmod 0644 "${LIGHTDM_CONF}"

if [[ "${RESTART_LIGHTDM}" == "1" ]]; then
  log "Restarting LightDM to enter signage mode"
  systemctl restart lightdm
else
  log "LightDM restart suppressed by --no-restart"
fi
