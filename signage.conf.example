# Copy this file to ./signage.conf before running install-signage.sh.
# The installer copies ./signage.conf to /etc/signage/signage.conf.
# During software updates, the repository copy of this file is treated as the
# sitewide configuration template. Only keys listed in
# SIGNAGE_CONFIG_PRESERVE_KEYS retain their existing Pi-local values.

# Required: URL of a plain Apache/Nginx-style directory listing containing slides.
# Read-only access must not require authentication.
SLIDES_URL="https://server.company.com/signage/show1"

# Optional: URL of a PEM-encoded root/intermediate CA certificate needed to trust
# the slides server's HTTPS certificate. Leave empty if the server uses a public CA
# or if no custom CA certificate is needed.
SLIDES_CA_CERT_URL=""

# Playback behavior.
SLIDESHOW_DELAY_SECONDS="8"

# Sync/reload behavior.
# signage-sync.timer runs every 5 minutes by default.
RESTART_THROTTLE_SECONDS="900"    # 15 minutes
HTTP_TIMEOUT_SECONDS="30"
KEEP_RELEASES="5"

# Candidate filename extensions to download from the directory listing.
# Files are then validated with feh before promotion.
IMAGE_EXTENSIONS="png jpg jpeg gif bmp webp tif tiff xpm pnm pbm pgm ppm"


# Optional automatic signage player software updates.
# WARNING: enabling this allows the device to download and run code from
# the configured repository. Use only with a trusted repository.
SIGNAGE_AUTO_UPDATE_ENABLED="false"

# Git repository containing the signage player software.
SIGNAGE_AUTO_UPDATE_REPO_URL=""

# Branch, tag, or HEAD to track for automatic software updates.
# HEAD means "use the default branch advertised by the configured Git repo."
SIGNAGE_AUTO_UPDATE_REF="HEAD"

# systemd OnCalendar expression for automatic update checks.
# Default: Tuesday at 3:00 AM local time.
SIGNAGE_AUTO_UPDATE_ONCALENDAR="Tue *-*-* 03:00:00"

# Space-separated config keys that should retain the Pi-local value during
# software updates. By default, only SLIDES_URL is treated as per-device data;
# update settings and other values are sitewide and may be replaced by the
# repository copy of this file.
SIGNAGE_CONFIG_PRESERVE_KEYS="SLIDES_URL"

# Safety default: do not restart LightDM during install.
# Set to 1 if you want the graphical login manager restarted automatically.
RESTART_LIGHTDM_AFTER_INSTALL="0"
